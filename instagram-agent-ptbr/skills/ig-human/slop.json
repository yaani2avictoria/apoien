  "structures": [
    {
      "id": "nao-e-so",
      "regex": "(?i)\\bn[ãa]o [ée] (?:s[óo]|apenas|somente) [^.!?\\n]{2,60}[,.;]\\s*[ée]\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Diga a única coisa que você quer dizer. Apague a metade da preparação."
    },
    {
      "id": "nao-apenas-mas-tambem",
      "regex": "(?i)\\bn[ãa]o (?:s[óo]|apenas|somente)\\b[^.!?\\n]{2,80}\\bmas (?:tamb[ée]m|sim)\\b",
      "name": "\"Não apenas X, mas também Y\"",
      "fix": "Divida em duas frases, ou corte a metade mais fraca."
    },
    {
      "id": "nao-e-sobre",
      "regex": "(?i)\\b(?:isso )?n[ãa]o [ée] sobre [^.!?\\n]{2,60}[.!,;]\\s*[ée] sobre\\b",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Comece pelo Y. A inversão é a marca."
    },
    {
      "id": "o-resultado",
      "regex": "(?im)^\\s*(?:o resultado|a melhor parte|o detalhe|o problema|a pegadinha|o segredo|e o melhor)\\?\\s*$",
      "name": "Linha de pergunta retórica curta",
      "fix": "Responda direto em vez de encenar uma revelação."
    },
    {
      "id": "o-que-aprendi",
      "regex": "(?i)\\b(?:aqui est[áa]|segue|veja|olha) o que (?:eu |n[óo]s |a gente )?aprend\\w+",
      "name": "\"Aqui está o que eu aprendi\"",
      "fix": "Diga a lição. Pule o anúncio."
    },
    {
      "id": "tripla",
      "regex": "(?i)\\b\\w+, \\w+ e \\w+\\.",
      "name": "Trio de três itens",
      "fix": "Dois itens ou quatro. Três é o ritmo padrão do modelo."
    },
    {
      "id": "foguete",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1✨\\U0001F3AF]",
      "name": "Emoji de foguete / fogo / lâmpada / brilho / alvo",
      "fix": "No máximo um emoji, e nenhum desses cinco."
    },
    {
      "id": "parede-de-hashtag",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Parede de hashtags (5+)",
      "fix": "Três hashtags específicas. O Instagram limitou a cinco por post."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:uma )?(?:ia|intelig[êe]ncia artificial)\\b|\\bcomo (?:um )?modelo de linguagem\\b",
      "name": "O modelo falando de si mesmo",
      "fix": "Apague a frase."
    },
    {
      "id": "em-resumo",
      "regex": "(?im)^\\s*(?:em resumo|resumindo|em suma|concluindo|em conclus[ãa]o|por fim)\\b",
      "name": "Abertura de conclusão de redação",
      "fix": "Post não precisa de parágrafo de conclusão."
    },
    {
      "id": "isca-de-engajamento",
      "regex": "(?im)(?:concorda\\?|o que voc[êe]s? acha(?:m)?\\?|quem mais\\b[^?\\n]*\\?|t[ôo] errad[oa]\\?|estou errad[oa]\\?)\\s*$",
      "name": "Isca de engajamento automática",
      "fix": "Faça uma pergunta que só você poderia fazer, sobre a coisa específica acima dela."
    },
    {
      "id": "para-de-rolar",
      "regex": "(?im)^\\s*(?:(?:para|pare|parem) de (?:rolar|passar|arrastar)|n[ãa]o (?:role|rola|passe|passa|pule|pula)\\b|espera[,.!]?\\s+n[ãa]o\\b)",
      "name": "Abertura \"para de rolar\"",
      "fix": "O que faz parar de rolar tem que ser a própria afirmação. Pedir atenção mostra que você ainda não conquistou."
    },
    {
      "id": "nesse-video",
      "regex": "(?i)\\b(?:nesse|neste|no) (?:v[íi]deo|reels?|post)(?: de hoje)? (?:eu )?vou\\b|\\bhoje (?:eu )?vou (?:te |lhes )?(?:mostrar|ensinar)\\b|\\bvou (?:te )?(?:mostrar|ensinar) (?:pra voc[êe]s? |para voc[êe]s? )?como\\b",
      "name": "Enrolação de vídeo (\"nesse vídeo eu vou te mostrar\")",
      "fix": "Apague e comece no resultado. Os dois primeiros segundos decidem o reels inteiro."
    },
    {
      "id": "vem-comigo",
      "regex": "(?i)\\bvem comigo\\b|\\bvem que eu te (?:mostro|explico|conto)\\b",
      "name": "Convite \"vem comigo\"",
      "fix": "Comece pelo conteúdo. Convidar pra assistir é tempo perdido."
    },
    {
      "id": "voce-sabia",
      "regex": "(?im)^\\s*(?:voc[êe] sabia que|sabia que)\\b",
      "name": "Abertura \"você sabia que\"",
      "fix": "Diga o fato direto. A pergunta só atrasa."
    },
    {
      "id": "lista-de-emoji",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Lista com emoji no lugar de marcador",
      "fix": "Use hífen ou quebra de linha. Emoji como marcador é a coisa com mais cara de modelo numa legenda."
    },
    {
      "id": "caps-gritando",
      "regex": "\\b[A-ZÁÂÃÀÉÊÍÓÔÕÚÜÇ]{3,}\\b(?:\\s+\\b[A-ZÁÂÃÀÉÊÍÓÔÕÚÜÇ]{3,}\\b){2,}",
      "name": "Três ou mais palavras gritadas seguidas",
      "fix": "Caixa alta é botão de volume, não marca-texto. Uma palavra, no máximo."
    },
    {
      "id": "isca-de-seguir",
      "regex": "(?i)\\b(?:me segue|me siga|siga pra mais|segue pra mais|siga para mais|marca (?:algu[ée]m|aquele amigo|aquela amiga|um amigo|uma amiga)|marque (?:algu[ée]m|um amigo|uma amiga)|curte se|d[áa] (?:um )?like se|compartilha se|comenta (?:aqui )?embaixo se|comente se)\\b",
      "name": "Pedido automático de seguir ou marcar",
      "fix": "Peça a única ação que esse post realmente merece. O pedido genérico ensina o público a ignorar todo pedido."
    }
